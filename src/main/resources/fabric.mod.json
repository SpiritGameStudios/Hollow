{
  "schemaVersion": 1,
  "id": "hollow",
  "version": "${version}",
  "name": "Hollow",
  "description": "A mod about hollow logs and hollow promises.",
  "authors": [
    "CallMeEcho",
    "WorldWidePixel"
  ],
  "contact": {
    "repo": "https://github.com/SpiritGameStudios/Hollow",
    "issues": "https://github.com/SpiritGameStudios/Hollow/issues"
  },
  "license": "MPL-2.0",
  "icon": "assets/hollow/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": [
      "dev.spiritstudios.hollow.client.HollowClient"
    ],
    "main": [
      "dev.spiritstudios.hollow.Hollow"
    ],
    "fabric-datagen": [
      "dev.spiritstudios.hollow.client.data.gen.HollowDatagen"
    ]
  },
  "mixins": [
    "hollow.mixins.json",
    {
      "config": "hollow.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "hollow.classtweaker",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "~26.2",
    "fabric-api": "*",
    "java": ">=25"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/TTmx7d2axf",
        "modmenu.github_releases": "https://github.com/SpiritGameStudios/Hollow/releases",
        "modmenu.modrinth": "https://modrinth.com/mod/hollow"
      }
    }
  }
}
